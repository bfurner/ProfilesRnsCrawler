# Copy to graphdb.env (gitignored), then run:
#   python3 LoadToGraphDB.py rdf/uchicago

# GraphDB Workbench URL
GRAPHDB_BASE_URL=http://localhost:7200

# Repository id
GRAPHDB_REPO=profiles

# Required when GraphDB security is enabled (Setup → Users and Access).
# Default admin credentials after enabling security: admin / root
GRAPHDB_USERNAME=admin
GRAPHDB_PASSWORD=root
